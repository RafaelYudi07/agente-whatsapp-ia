{
  "name": "Agente IA WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "options": {}
      },
      "id": "a1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "evento",
              "type": "string",
              "value": "={{ $json.body.event }}"
            },
            {
              "id": "f2",
              "name": "instancia",
              "type": "string",
              "value": "={{ $json.body.instance }}"
            },
            {
              "id": "f3",
              "name": "jid",
              "type": "string",
              "value": "={{ (($json.body.data?.key?.remoteJid ?? '').endsWith('@lid') && $json.body.data?.key?.remoteJidAlt ? $json.body.data.key.remoteJidAlt : ($json.body.data?.key?.remoteJid ?? '')) }}"
            },
            {
              "id": "f4",
              "name": "numero",
              "type": "string",
              "value": "={{ (($json.body.data?.key?.remoteJid ?? '').endsWith('@lid') && $json.body.data?.key?.remoteJidAlt ? $json.body.data.key.remoteJidAlt : ($json.body.data?.key?.remoteJid ?? '')).endsWith('@lid') ? (($json.body.data?.key?.remoteJid ?? '').endsWith('@lid') && $json.body.data?.key?.remoteJidAlt ? $json.body.data.key.remoteJidAlt : ($json.body.data?.key?.remoteJid ?? '')) : (($json.body.data?.key?.remoteJid ?? '').endsWith('@lid') && $json.body.data?.key?.remoteJidAlt ? $json.body.data.key.remoteJidAlt : ($json.body.data?.key?.remoteJid ?? '')).split('@')[0] }}"
            },
            {
              "id": "f5",
              "name": "deMim",
              "type": "boolean",
              "value": "={{ $json.body.data?.key?.fromMe === true }}"
            },
            {
              "id": "f6",
              "name": "nome",
              "type": "string",
              "value": "={{ $json.body.data?.pushName ?? '' }}"
            },
            {
              "id": "f7",
              "name": "texto",
              "type": "string",
              "value": "={{ $json.body.data?.message?.conversation ?? $json.body.data?.message?.extendedTextMessage?.text ?? '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a2",
      "name": "Normalizar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.evento }}",
              "rightValue": "messages.upsert",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.deMim }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "id": "c3",
              "leftValue": "={{ $json.jid }}",
              "rightValue": "@g.us",
              "operator": {
                "type": "string",
                "operation": "notEndsWith"
              }
            },
            {
              "id": "c4",
              "leftValue": "={{ $json.texto }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c5",
              "leftValue": "={{ $json.jid }}",
              "rightValue": "@broadcast",
              "operator": {
                "type": "string",
                "operation": "notEndsWith"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a3",
      "name": "Mensagem de texto recebida?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Chat de teste').isExecuted ? $('Normalizar chat').item.json.texto : $('Normalizar').item.json.texto }}",
        "options": {
          "systemMessage": "={{ $('Config do painel').item.json.prompt }}"
        }
      },
      "id": "a4",
      "name": "Agente IA",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1120,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.8-flash",
        "options": {
          "temperature": 0.4
        }
      },
      "id": "a5",
      "name": "Gemini",
